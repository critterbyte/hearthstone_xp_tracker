<Project Sdk="Microsoft.NET.Sdk">

  <!-- net472 for the app, netstandard2.0 for tests and tools on modern .NET -->
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0</TargetFrameworks>
    <RootNamespace>XpTracker.Core</RootNamespace>
  </PropertyGroup>

  <!-- One text file per language, embedded in this DLL (no satellite assemblies, so the release keeps two DLLs). -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.txt" WithCulture="false" LogicalName="XpTracker.Core.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
